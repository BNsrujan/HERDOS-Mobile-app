{
  "expo": {
    "name": "Herdos",
    "slug": "Herdos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-glow.png",
    "scheme": "herdos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.herdos.app",
      "icon": "./assets/images/logo-glow.png",
      "config": {
        "googleMapsApiKey": "REPLACE_WITH_IOS_GOOGLE_MAPS_KEY"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-glow.png"
        // "backgroundImage": "./assets/images/android-icon-background.png",
        // "monochromeImage": "./assets/images/logo-glow.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.herdos.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCiKtrtOiPU_h0bY0BSOQivqzuJRwHGpJs"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.ico"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash.svg",
          "imageWidth": 300
        }
      ],
      "expo-image",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2b51037-bd52-47cb-908c-15883f2fc056"
      }
    }
  }
}
